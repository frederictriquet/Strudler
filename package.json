{
  "name": "strudler",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Live music-as-code performance instrument built on Strudel + Web MIDI",
  "scripts": {
    "dev": "vite",
    "build": "svelte-check --tsconfig ./tsconfig.json && vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "probe": "node scripts/probe.mjs",
    "samples:fetch": "node scripts/fetch-samples.mjs",
    "samples:piano": "node scripts/fetch-piano.mjs",
    "samples:banks": "node scripts/fetch-banks.mjs",
    "samples:soundfonts": "node scripts/fetch-soundfonts.mjs",
    "cues:monitor": "node scripts/cue-monitor.mjs"
  },
  "dependencies": {
    "@elgato-stream-deck/webhid": "^7.6.3",
    "@strudel/core": "^1.1.0",
    "@strudel/mini": "^1.1.0",
    "@strudel/soundfonts": "^1.3.0",
    "@strudel/tonal": "^1.2.6",
    "@strudel/transpiler": "^1.1.0",
    "@strudel/webaudio": "^1.1.0",
    "@tonaljs/chord-detect": "^4.9.1",
    "@tonaljs/chord-type": "^5.1.1",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tsconfig/svelte": "^5.0.4",
    "@types/node": "^22.0.0",
    "@types/webmidi": "^2.1.0",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "typescript": "^5.6.0",
    "vite": "^8.3.5"
  }
}
