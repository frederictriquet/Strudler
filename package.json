{
  "name": "strudler",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Live music-as-code performance instrument built on Strudel + Web MIDI",
  "scripts": {
    "dev": "vite",
    "build": "svelte-check --tsconfig ./tsconfig.json && vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "samples:fetch": "node scripts/fetch-samples.mjs",
    "samples:piano": "node scripts/fetch-piano.mjs",
    "samples:banks": "node scripts/fetch-banks.mjs"
  },
  "dependencies": {
    "@elgato-stream-deck/webhid": "^7.6.3",
    "@strudel/core": "^1.1.0",
    "@strudel/mini": "^1.1.0",
    "@strudel/transpiler": "^1.1.0",
    "@strudel/webaudio": "^1.1.0"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^4.0.0",
    "@tsconfig/svelte": "^5.0.4",
    "@types/node": "^22.0.0",
    "@types/webmidi": "^2.1.0",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0"
  }
}
